    "D16",
    "D17",
    "D18",
    "D19",
    "G1",
    "G2",
    "G3a",
    "G4a=GO",
    "decision_sync",
    "implementation_plan"
  ],
  "enablement_gates": ["G3b", "G4b"]
}
