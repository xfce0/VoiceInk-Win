    "verify_before_open": true
  },
  "frame": {
    "magic": "VIKA",
    "version_field": "u16",
    "type_field": "u8",
    "flags_field": "u8",
    "generation_field": "u64",
    "sequence_field": "u64",
    "deadline_ns_field": "u64",
    "payload_length_field": "u32",
    "tag": "hmac_sha256[32]",
    "max_payload_bytes": 65536,
    "canonical_chunk_bytes": 32768,
    "aggregate_ipc_queue_bytes": 4194304
  },
  "messages": [
    "HELLO",
    "OPEN",
    "START",
    "AUDIO",
    "STOP",
    "CANCEL",
    "STATUS",
    "RESULT",
    "CLOSE"
  ],
  "reject_before_payload_allocation": [
    "malformed",
    "replayed",
    "oversized",
    "out_of_order",
    "wrong_generation",
    "wrong_direction",
    "wrong_version",
    "wrong_hmac"
  ],
  "audio_boundary": {
    "helper_to_parent": "canonical-mono-16000-s16le-chunks-only",
