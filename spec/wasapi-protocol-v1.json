  "status": "blocked",
  "implementation_allowed": false,
  "source_documents": [
    "rfcs/microphone-recording.md",
    "spec/features/005-microphone-recording.md"
  ],
  "transport": {
    "kind": "current-user-named-pipe",
    "pipe_owner": "parent",
    "helper_receives_inherited_server_handle": true,
    "remote_clients": "rejected",
    "reconnect": false
