{
  "schema": "voiceink.wasapi.helper-build-contract.v1",
  "version": 1,
  "status": "blocked",
  "implementation_allowed": false,
  "target": {
    "operating_systems": [
      "Windows 10 22H2",
      "Windows 11 23H2",
      "Windows 11 24H2"
    ],
    "architecture": "x64",
